+def test_writer_partials_project_linearly_before_reduction():
+    g = torch.Generator().manual_seed(7)
+    direction = torch.randn(1024, generator=g).float()
+    direction /= direction.norm()
+    parts = [torch.randn(2, 1024, generator=g) for _ in range(2)]
+    full = parts[0] + parts[1]
+    want = full - (0.5 * (full @ direction)).view(2, 1) * direction
+    for part in parts:
+        GLP.glp_project(part, direction, 0.5)
+    assert torch.allclose(parts[0] + parts[1], want, atol=1e-5, rtol=1e-5)
+
