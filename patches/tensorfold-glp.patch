+@pytest.mark.parametrize("split", [False, True])
+def test_wo_b_applies_companion_projection_in_normal_and_split_paths(split):
+    direction = torch.ones(1024).float() / 32
+    blk = SimpleNamespace(index=0, glp_dirs=direction.unsqueeze(0), glp_alpha=0.5,
+                          attn=SimpleNamespace(wo_b=lambda z, dtype: z.clone()))
+    x = torch.randn(2, 1024)
+    want = x - (0.5 * (x @ direction)).view(2, 1) * direction
+    if not split:
+        got = B._wo_b(blk, x, torch.float32, None)
+    else:
+        class Emit:
+            def __init__(self):
+                self.parts = []
+
+            def spans_of(self, n):
+                return [(0, 1), (1, n)]
+
+            def send(self, a, b, part):
+                self.parts.append(part)
+
+        emit = Emit()
+        B._wo_b(blk, x, torch.float32, emit)
+        got = torch.cat(emit.parts)
+    assert torch.allclose(got, want, atol=1e-6, rtol=1e-6)
+
