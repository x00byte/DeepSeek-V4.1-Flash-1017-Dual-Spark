+++ local/tests/test_dsv41_glp.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: MIT
+"""GLP spec_version 3 loading, fold/writer math, and off-is-stock forward behavior."""
+
+from __future__ import annotations
+
+import struct
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import blocks as B  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import glp as GLP  # noqa: E402
+from test_dsv41_forward import IDS, build, run, tp2  # noqa: E402
+
+
+def _string(value: str) -> bytes:
+    raw = value.encode()
+    return struct.pack("<Q", len(raw)) + raw
+
+
+def write_gguf(path, directions: dict[str, np.ndarray], **overrides):
+    meta = {
+        "glp.mode": "project",
+        "glp.hook_point": GLP.HOOK,
+        "glp.spec_version": 3,
+        "glp.alpha_default": 0.5,
+        "glp.rank": 1,
+        **overrides,
+    }
+    if "glp.layer_ids_zero_based" not in meta:
+        meta["glp.layer_ids_zero_based"] = ",".join(
+            str(i) for i in sorted({int(name.split(".")[1]) for name in directions})
+        )
+    types = {str: 8, int: 4, float: 6}
+    chunks = [b"GGUF", struct.pack("<IQQ", 3, len(directions), len(meta))]
+    for key, value in meta.items():
+        chunks += [_string(key), struct.pack("<I", types[type(value)])]
+        if isinstance(value, str):
+            chunks.append(_string(value))
+        elif isinstance(value, int):
+            chunks.append(struct.pack("<I", value))
+        else:
+            chunks.append(struct.pack("<f", value))
+    offset = 0
+    for name, values in directions.items():
+        chunks += [_string(name), struct.pack("<I", 1), struct.pack("<Q", values.size),
+                   struct.pack("<I", 0), struct.pack("<Q", offset)]
+        offset += values.nbytes
+    payload = b"".join(chunks)
+    payload += b"\0" * ((-len(payload)) % 32)
+    path.write_bytes(payload + b"".join(np.asarray(v, dtype="<f4").tobytes() for v in directions.values()))
+
+
+def vector(tmp_path, **overrides):
+    directions = {f"direction.{i}": np.ones(1024, dtype=np.float32) for i in (1, 11, 37)}
+    path = tmp_path / "control.gguf"
+    write_gguf(path, directions, **overrides)
+    return path
+
+
+def test_load_accepts_rank_one_v3_and_normalizes(tmp_path):
+    dirs, alpha, sha = GLP.load(str(vector(tmp_path)), layers=40, width=1024)
+    assert sorted(dirs) == [1, 11, 37]
+    assert alpha == 0.5
+    assert sha > 0
+    for direction in dirs.values():
+        assert np.allclose(direction, 1 / 32)
+
+
+@pytest.mark.parametrize("overrides, match", [
+    ({"glp.spec_version": 2}, "require version 3"),
+    ({"glp.hook_point": "residual_stream_post_layer"}, "expected"),
+    ({"glp.derived_at": "residual_stream_post_layer"}, "calibration site"),
+    ({"glp.mode": "add"}, "projective"),
+    ({"glp.dir_scales": "1.0"}, "alphas"),
+    ({"glp.layer_ids_zero_based": "1,11"}, "do not match"),
+])
+def test_load_refuses_incompatible_metadata(tmp_path, overrides, match):
+    with pytest.raises(ValueError, match=match):
+        GLP.load(str(vector(tmp_path, **overrides)), layers=40, width=1024)
+
+
+def test_load_refuses_final_layer_and_wrong_width(tmp_path):
+    path = tmp_path / "final.gguf"
+    write_gguf(path, {f"direction.{i}": np.ones(1024, dtype=np.float32) for i in (1, 11, 37, 39)})
+    with pytest.raises(ValueError, match="fused into final normalization"):
+        GLP.load(str(path), layers=40, width=1024)
+    path = tmp_path / "wrong.gguf"
+    write_gguf(path, {"direction.1": np.ones(512, dtype=np.float32)})
+    with pytest.raises(ValueError, match="expected hidden width 1024"):
+        GLP.load(str(path), layers=40, width=1024)
+
+
+def test_load_refuses_rank_two(tmp_path):
+    path = tmp_path / "rank2.gguf"
+    write_gguf(path, {"direction.1": np.ones(1024, dtype=np.float32),
+                      "direction.1.1": np.ones(1024, dtype=np.float32)}, **{"glp.rank": 2})
+    with pytest.raises(ValueError, match="only rank-1"):
+        GLP.load(str(path), layers=40, width=1024)
+
+
+def test_projection_matches_mean_over_copies_on_cpu():
+    g = torch.Generator().manual_seed(4)
+    hidden = 1024
+    direction = torch.randn(hidden, generator=g).float()
+    direction /= direction.norm()
+    for copies in (1, 4):
+        x = torch.randn(2, copies * hidden, generator=g).to(torch.bfloat16)
+        want = x.reshape(2, copies, hidden).float()
+        mean = want.mean(dim=1)
+        want = (want - (0.5 * (mean @ direction)).view(2, 1, 1) * direction).to(torch.bfloat16).float()
+        GLP.glp_project(x, direction, 0.5, copies=copies)
+        got = x.reshape(2, copies, hidden).float()
+        assert torch.allclose(got, want, atol=0.008, rtol=0.01)
+
+
+def test_zero_alpha_is_exact_noop():
+    x = torch.randn(2, 4 * 1024).to(torch.bfloat16)
+    want = x.clone()
+    direction = torch.ones(1024).float()
