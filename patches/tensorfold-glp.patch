diff --git upstream/src/tensorfold/families/deepseek_v41/cuda/glp.py local/src/tensorfold/families/deepseek_v41/cuda/glp.py
new file mode 100644
index 0000000..c323220
--- /dev/null
+++ local/src/tensorfold/families/deepseek_v41/cuda/glp.py
@@ -0,0 +1,282 @@
+"""GLP (GGUF Layer Projection) steering: a per-layer direction projected off the widened mHC stream.
+
+A GLP sidecar is a small GGUF v3 file of per-decoder-layer unit directions (F32 tensors ``direction.<N>``, N the
+1-based layer id, layer 0 inexpressible) under a ``glp.*`` metadata contract. With ``glp.mode=project`` every row of
+the stream is edited after each steered layer: ``x <- x - alpha * (x . d) d``. The contract is fail-closed: a reader
+that does not understand the file must refuse it, never fall back to adding (the same numbers under the wrong
+operation produce no error, just wrong output).
+
+Format, derivation and published vectors: https://github.com/msuiche/weightless (docs/spec/GLP.md) and
+https://weightless.msuiche.com. The reference reader this file's gates mirror is
+vllm-plugin/weightless_steer/container.py there.
+
+This lane implements the scalar case: rank-1 vectors, one alpha for every steered layer, the
+``residual_stream_post_layer`` hook. Rank-k (subspace) files and the spec_version-2 alpha multipliers are refused
+rather than partially applied. The apply itself is ``glp_project`` below (called from ``forward._layers``, right
+after a block's mHC post lands on the stream); this module reads and validates.
+
+Hook geometry, DeepSeek-V4.1 specifics: the stream is the widened mHC stream ``[rows, hc_mult * hidden]`` (4 x
+5,120 = 20,480 for the 1017 checkpoint), replicated on both ranks, so each rank projecting its own copy keeps the
+ranks in lockstep. ``direction.N`` applies at zero-based layer ``N`` (the GLP container contract: N >= 1, N is the
+layer index). Block ``i``'s post is applied at the top of block ``i + 1``'s iteration (``ops.post_only`` /
+``XO.post_only``), so the steerable sites are layers 1..38; layer 39's post is fused into the final norm kernel
+(``hc.final`` / ``XO.final``), so ``direction.39`` has no site and ``load`` refuses it.
+
+TF_DSV41_GLP names the sidecar (a container path, the same on both ranks); TF_DSV41_GLP_ALPHA overrides the file's
+glp.alpha_default. The engine refuses to start when the file is missing, malformed, made for another hook or model,
+or differs between the ranks.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import re
+import struct
+
+import numpy as np
+
+HOOK = "residual_stream_post_layer"       # the one site this engine steers (after the layer's mHC post)
+
+_SZ = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
+_FM = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f",
+       7: "<B", 10: "<Q", 11: "<q", 12: "<d"}
+
+_DIRECTION_RE = re.compile(r"direction\.(\d+)(?:\.(\d+))?")
+
+
+def _int_meta(meta: dict, key: str, default: int) -> int:
+    """An integer metadata value, coerced: real GGUF writers emit uint32, fixture files carry strings."""
+    v = meta.get(key)
+    if v is None or v == "":
+        return default
+    return int(float(str(v)))
+
+
+def read_gguf(path: str) -> tuple[dict, dict[str, np.ndarray]]:
+    """Minimal GGUF v3 reader for control vectors (F32 tensors only): (metadata, {tensor name: array})."""
+
+    with open(path, "rb") as f:
+        data = f.read()
+    if data[:4] != b"GGUF":
+        raise ValueError(f"{path}: bad magic, not a GGUF file")
+    ver, n_tensors, n_kv = struct.unpack_from("<IQQ", data, 4)
+    if ver != 3:
+        raise ValueError(f"{path}: GGUF version {ver}, expected 3")
+    off = 24
+
+    def rd_string(o):
+        (n,) = struct.unpack_from("<Q", data, o)
+        o += 8
+        return data[o:o + n].decode("utf-8"), o + n
+
+    meta = {}
+    for _ in range(n_kv):
+        key, off = rd_string(off)
+        (vtype,) = struct.unpack_from("<I", data, off)
+        off += 4
+        if vtype == 8:    # string
+            val, off = rd_string(off)
+        elif vtype == 9:  # array
+            etype, cnt = struct.unpack_from("<IQ", data, off)
+            off += 12
+            if etype == 8:
+                val = []
+                for _ in range(cnt):
+                    s, off = rd_string(off)
+                    val.append(s)
+            else:
+                val = struct.unpack_from(f"<{cnt}{_FM[etype][1]}", data, off)
+                off += _SZ[etype] * cnt
+        else:
+            (val,) = struct.unpack_from(_FM[vtype], data, off)
+            off += _SZ[vtype]
+        meta[key] = val
+
+    infos = []
+    for _ in range(n_tensors):
+        name, off = rd_string(off)
+        (nd,) = struct.unpack_from("<I", data, off)
+        off += 4
+        dims = struct.unpack_from(f"<{nd}Q", data, off)
+        off += 8 * nd
+        (tt,) = struct.unpack_from("<I", data, off)
+        off += 4
+        (toff,) = struct.unpack_from("<Q", data, off)
+        off += 8
+        infos.append((name, dims, tt, toff))
+
+    align = meta.get("general.alignment", 32)
+    base = (off + align - 1) // align * align
+    tensors = {}
+    for name, dims, tt, toff in infos:
+        if tt != 0:
+            raise ValueError(f"{path}: {name} is not F32 (ggml type {tt})")
+        n = 1
+        for d in dims:
+            n *= d
+        tensors[name] = np.frombuffer(data, dtype="<f4", count=n, offset=base + toff).copy()
+    return meta, tensors
+
+
+def load(path: str, *, layers: int, width: int) -> tuple[dict[int, np.ndarray], float, int]:
+    """Read and validate a GLP sidecar for a model of ``layers`` decoder layers and a ``width``-wide stream.
+
+    Returns ({layer id: unit F32 direction}, alpha, content hash). Every check here is a refusal, not a warning:
+    a boot that asked for steering must never serve unsteered, and a file this lane cannot honour exactly must not
+    be applied approximately. ``alpha`` is the file's glp.alpha_default (1.0 when absent); the caller applies the
+    TF_DSV41_GLP_ALPHA override. ``layers`` is the block count (40): direction.1..direction.layers - 2 are
+    accepted (their posts land inside the layer loop); direction.layers - 1 is refused with the fused-final
+    note below.
+    """
+
+    with open(path, "rb") as f:
+        raw = f.read()
+    sha = int.from_bytes(hashlib.sha256(raw).digest()[:4], "little") & 0x7FFF_FFFF  # int32, for the rank fingerprint
+    meta, tensors = read_gguf(path)
+
+    mode = meta.get("glp.mode")
+    if mode is None:
+        raise ValueError(f"{path}: no glp.mode. Refusing to guess: an additive control vector and a projective one "
+                         "are different operations.")
+    if mode != "project":
+        raise ValueError(f"{path}: glp.mode={mode!r}, but this engine only implements projective ablation "
+                         "(x -= alpha*(x.d)d). Refusing to apply.")
+
+    file_hook = meta.get("glp.hook_point")
+    if file_hook != HOOK:
+        raise ValueError(f"{path}: glp.hook_point={file_hook!r} does not match this engine's hook ({HOOK}). "
+                         "Refusing to apply at the wrong site.")
+
+    # The version gate: rank > 1 and the alpha-scaling keys change what a reader computes, so they are only valid
+    # under spec_version 2. A version-1 reader would ignore keys it does not know and apply the file with the wrong
+    # alphas -- silently. Refuse instead.
+    version = _int_meta(meta, "glp.spec_version", 1)
+    if version not in (1, 2):
+        raise ValueError(f"{path}: glp.spec_version={meta.get('glp.spec_version')!r} is not implemented by this "
+                         "reader (1 and 2 are). Refusing.")
+    rank_declared = _int_meta(meta, "glp.rank", 1)
+    if version == 1 and (rank_declared != 1 or "glp.dir_scales" in meta or "glp.layer_scales" in meta):
+        raise ValueError(f"{path}: glp.rank={rank_declared} / alpha-scaling keys require glp.spec_version 2 "
+                         "(this file declares 1). Refusing.")
+
+    # This lane serves one scalar alpha for every steered layer; a file carrying per-direction or per-layer
+    # multipliers would be served at the wrong strength with no way to tell from the output.
+    scales = sorted(set(meta) & {"glp.dir_scales", "glp.layer_scales"})
+    if scales:
+        raise ValueError(f"{path}: carries {', '.join(scales)}, which this engine does not implement. Refusing to "
+                         "ignore alpha multipliers.")
+    if rank_declared != 1:
+        raise ValueError(f"{path}: glp.rank={rank_declared} (subspace) -- this engine implements rank 1 only. "
+                         "Refusing to serve a partially applied subspace.")
+
+    alpha = float(meta.get("glp.alpha_default", 1.0))
+    if not math.isfinite(alpha):
+        raise ValueError(f"{path}: glp.alpha_default must be finite, not {meta.get('glp.alpha_default')!r}")
+
+    grouped: dict[int, dict[int, np.ndarray]] = {}
+    for name, arr in tensors.items():
+        m = _DIRECTION_RE.fullmatch(name)
+        if m is None:
+            if name.startswith("direction."):
+                raise ValueError(f"{path}: malformed tensor name {name!r} -- 'direction.' must be followed by an "
+                                 "integer layer id")
+            continue
+        idx, j = int(m.group(1)), int(m.group(2) or 0)
+        if idx < 1:
+            raise ValueError(f"{path}: {name} is invalid; layer 0 cannot be expressed in this container")
+        if j != 0:
+            raise ValueError(f"{path}: {name} names a rank-{j + 1} direction; this engine implements rank 1 only. "
+                             "Refusing.")
+        arr = np.asarray(arr, dtype=np.float32).reshape(-1)
+        if not np.isfinite(arr).all() or not np.any(arr):
+            raise ValueError(f"{path}: {name} must be finite and nonzero")
+        grouped.setdefault(idx, {})[j] = arr
+    if not grouped:
+        raise ValueError(f"{path}: no direction.<N> tensors found")
+
+    # Cross-check the tensor names against the informational layer list: they are written from the same source, so a
+    # disagreement means a broken exporter. The names are what execute; a one-layer shift degrades rather than fails
+    # (adjacent-layer refusal directions are highly correlated), so this check is load-bearing.
+    declared = meta.get("glp.layer_ids_zero_based")
+    if declared:
+        try:
+            want = sorted(int(x) for x in declared.split(",") if x.strip())
+        except ValueError:
+            raise ValueError(f"{path}: glp.layer_ids_zero_based is not a comma list of integers: {declared!r}") \
+                from None
+        if want and want != sorted(grouped):
+            raise ValueError(f"{path}: glp.layer_ids_zero_based declares layers {want[0]}..{want[-1]} "
+                             f"({len(want)} entries) but the direction tensors resolve to {sorted(grouped)[0]}.."
+                             f"{sorted(grouped)[-1]} ({len(grouped)} entries). The tensor names are what get "
+                             "applied, so this file would steer the wrong layers. Re-export it.")
+
+    dirs: dict[int, np.ndarray] = {}
+    for idx, js in grouped.items():
+        if not 0 <= idx < layers - 1:
+            note = (": layer %d's mHC post is fused into the final norm kernel, so it has no steerable site "
+                    "in this engine -- export the vector without it" % idx) if idx == layers - 1 else ""
+            raise ValueError(f"{path}: direction layer {idx} has no steerable site in this engine ({layers} "
+                             f"layers, steerable post-sites 1..{layers - 2}){note}")
+        vec = js[0].astype(np.float64)
+        if vec.size != width:
+            raise ValueError(f"{path}: direction layer {idx} is {vec.size} wide; this model's widened stream is "
+                             f"{width} (hc_mult * hidden). Refusing to steer a different geometry.")
+        # The published vectors ship unit directions; normalise anyway (in float64, so a finite but extreme f32
+        # export cannot overflow its own squared norm) so no export can silently scale alpha.
+        norm = np.linalg.norm(vec)
+        if not math.isfinite(norm) or norm <= 0:
+            raise ValueError(f"{path}: direction layer {idx} must be finite and nonzero")
+        dirs[idx] = (vec / norm).astype(np.float32)
+
+    return dirs, alpha, sha
+
+
+# -- the apply --------------------------------------------------------------------------------------------------
+# torch / triton import lazily: the reader above also runs on GPU-less machines (tools/glpcheck.py's gates mirror
+# it), and this module must stay importable there.
+
+def glp_project(x, drow, alpha: float) -> None:
+    """In place on x [R, hc_mult * D] bf16: project this layer's GLP direction off every row (drow fp32, unit)."""
+
+    global _KERNEL
+    import torch                              # noqa: PLC0415 -- lazy, see above
+
+    if x.dtype is not torch.bfloat16:
+        raise ValueError(f"glp_project: the stream is {x.dtype}, the kernel writes bf16 (N.ACT)")
+    rows, wide = x.shape
+    if wide % 1024:
+        raise ValueError(f"glp_project: stream width {wide} is not a multiple of 1024")
+    if _KERNEL is None:                       # built on first use (the eager warm-up, before any graph capture)
+        _KERNEL = _kernel()
+    _KERNEL[(rows,)](x, drow, float(alpha), D=wide, BLOCK=1024, num_warps=4)
+
+
+def _kernel():
+    import triton                            # noqa: PLC0415 -- lazy, see above
+    import triton.language as tl             # noqa: PLC0415
+
+    @triton.jit
+    def _glp_project(X, DIR, alpha, D: tl.constexpr, BLOCK: tl.constexpr):
+        """Row r of the widened stream: x <- x - alpha * (x . d) d; the dot accumulates fp32 in fixed block order
+        and the write-back rounds to bf16 explicitly, so both ranks compute identical bits. A zero DIR row is an
+        exact no-op (bf16 -> fp32 -> bf16 is lossless), which keeps the captured graph identical for every layer
+        set."""
+
+        r = tl.program_id(0)
+        acc = 0.0
+        for cb in tl.static_range(D // BLOCK):
+            d = cb * BLOCK + tl.arange(0, BLOCK)
+            x = tl.load(X + r * D + d).to(tl.float32)
+            acc += tl.sum(x * tl.load(DIR + d), axis=0)
+        coef = alpha * acc
+        for cb in tl.static_range(D // BLOCK):
+            d = cb * BLOCK + tl.arange(0, BLOCK)
+            x = tl.load(X + r * D + d).to(tl.float32)
+            v = tl.load(DIR + d)
+            tl.store(X + r * D + d, (x - coef * v).to(tl.bfloat16))
+
+    return _glp_project
+
+
+_KERNEL = None                                # the compiled kernel, built on first use (triton import-time optional)
