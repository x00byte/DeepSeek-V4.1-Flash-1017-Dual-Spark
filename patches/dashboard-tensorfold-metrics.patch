+++ b/dashboard/test_tensorfold_metrics.py
@@ -0,0 +1,111 @@
+"""TensorFold live rates use actual health progress, without completed-counter duplication."""
+import ast
+from collections import deque
+from datetime import datetime, timezone
+import io
+import json
+import math
+from pathlib import Path
+import re
+import threading
+import time
+from typing import Any
+import unittest
+from unittest.mock import patch
+import urllib.request
+
+tree = ast.parse(Path(__file__).with_name('server.py').read_text())
+names = {'_empty_metrics', '_labels', 'parse_prometheus', '_tensorfold_prefill_display', 'MetricsSampler'}
+constants = {'COUNTER_METRICS', 'GAUGE_METRICS', 'METRIC_LINE', 'LABEL'}
+nodes = [n for n in tree.body if (
+    isinstance(n, (ast.FunctionDef, ast.ClassDef)) and n.name in names
+) or (isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id in constants for t in n.targets))]
+ns = dict(Any=Any, deque=deque, datetime=datetime, UTC=timezone.utc, threading=threading,
+          time=time, re=re, math=math, json=json, urllib=urllib,
+          METRICS_URL='http://localhost:8888/metrics')
+exec(compile(ast.Module(body=nodes, type_ignores=[]), 'server.py', 'exec'), ns)
+
+NATIVE = '''tensorfold_requests_total{model="deepseek-flash"} 2
+tensorfold_request_errors_total{model="deepseek-flash"} 0
+tensorfold_prompt_tokens_total{model="deepseek-flash"} 1000
+tensorfold_cached_tokens_total{model="deepseek-flash"} 0
+tensorfold_completion_tokens_total{model="deepseek-flash"} 20
+tensorfold_requests_inflight{model="deepseek-flash"} 2
+tensorfold_prefill_seconds_total{model="deepseek-flash"} 0
+tensorfold_decode_seconds_total{model="deepseek-flash"} 10
+'''
+
+
+class TensorFoldMetricsTests(unittest.TestCase):
+    def test_native_names_and_model_label(self):
+        result = ns['parse_prometheus'](NATIVE)
+        self.assertEqual(result['backend'], 'tensorfold')
+        self.assertEqual(result['model'], 'deepseek-flash')
+        self.assertEqual(result['generated_tokens'], 20)
+        self.assertEqual(result['running'], 2)
+
+    def test_health_only_detection_and_legacy_names(self):
+        health = ns['parse_prometheus']('tensorfold_health:completion_tokens_total 42')
+        legacy = ns['parse_prometheus']('tensorfold:generation_tokens_total{model_name="qwen"} 12')
+        self.assertEqual(health['backend'], 'tensorfold')
+        self.assertEqual(health['generated_tokens'], 42)
+        self.assertEqual(legacy['backend'], 'tensorfold')
+        self.assertEqual(legacy['model'], 'qwen')
+        self.assertEqual(legacy['generated_tokens'], 12)
+
+    def test_live_health_preferred_without_double_counting(self):
+        result = ns['parse_prometheus'](NATIVE + '''tensorfold_health:requests_total 2
+tensorfold_health:prompt_tokens_total 3000
+tensorfold_health:completion_tokens_total 80
+tensorfold_health:decode_seconds_total 10
+tensorfold_health:cached_tokens_total 0
+tensorfold_health:prefill_scheduled_tokens_total 1536
+''')
+        self.assertEqual(result['model'], 'deepseek-flash')
+        self.assertEqual(result['completed_requests'], 2)
+        self.assertEqual(result['generated_tokens'], 80)
+        self.assertEqual(result['decode_time_sum'], 10)
+        self.assertEqual(result['live_prefill_tokens'], 1536)
+        self.assertEqual(result['live_prefill_source'], 'live_scheduled')
+        self.assertEqual(result['prompt_tokens'], 3000)
+
+    def test_fetch_uses_nested_chunk_progress_while_requests_are_active(self):
+        health = dict(ok=True, requests_total=2, prompt_tokens_total=3000,
+                      completion_tokens_total=80, cached_tokens_total=0,
+                      streams=dict(max=8, prefilling=1, decoding=1),
+                      context_length=262144, deepseek_phase=dict(prefill_tokens=1536))
+        responses = [io.BytesIO(NATIVE.encode()),
+                     io.BytesIO(json.dumps({'data': [{'id': 'deepseek-flash'}]}).encode()),
+                     io.BytesIO(json.dumps(health).encode())]
+        sampler = ns['MetricsSampler'].__new__(ns['MetricsSampler'])
+        with patch.object(urllib.request, 'urlopen', side_effect=responses):
+            result, _ = sampler._fetch()
+        self.assertEqual(result['model'], 'deepseek-flash')
+        self.assertEqual(result['generated_tokens'], 80)
+        self.assertEqual(result['live_prefill_tokens'], 1536)
+        self.assertEqual(result['prefilling'], 1)
+
+        base = dict(t=10, generated=80, prompt=3000, prompt_eff=3000,
+                    live_prefill=1536, accepted=0, draft_tokens=0, drafts=0, kv_pct=0)
+        result.update(generated_tokens=180, live_prefill_tokens=4608)
+        rates = sampler._window_metrics(result, base, 12)
+        self.assertEqual(rates['generationTps'], 50)
+        self.assertEqual(rates['prefillLiveTps'], 1536)
+        self.assertEqual(rates['prefillTps'], 0)
+        self.assertEqual(ns['_tensorfold_prefill_display'](result, rates, {}), (1536, 'live_scheduled'))
+
+    def test_missing_live_counter_does_not_invent_prefill_rate(self):
+        current = dict(prefilling=1, live_prefill_tokens=None)
+        self.assertEqual(ns['_tensorfold_prefill_display'](current, {}, {}), (None, 'completed_average'))
+
+    def test_reset_counter_does_not_create_negative_prefill(self):
+        sampler = ns['MetricsSampler'].__new__(ns['MetricsSampler'])
+        current = ns['parse_prometheus'](NATIVE)
+        current['live_prefill_tokens'] = 100
+        base = dict(t=10, generated=0, prompt=0, accepted=0, draft_tokens=0, drafts=0,
+                    kv_pct=0, live_prefill=10000)
+        self.assertNotIn('prefillLiveTps', sampler._window_metrics(current, base, 12))
+
+
+if __name__ == '__main__':
+    unittest.main()
