+"""GLP spec_version 3 steering at DeepSeek-V4.1's hyper-connection fold.
+
+A sidecar carries rank-1 F32 ``direction.<N>`` tensors under ``glp.mode=project`` and
+``glp.hook_point=hc_fold_pre_engram``. For each row, the fold computes ``h = mean_c(stream_c)`` and every copy
+loses ``alpha * (h.d)d``. The attention output writer applies the same layer's direction and alpha to its partials;
+projection is linear, so projecting before the rank reduction is equivalent to projecting the reduced writer.
+
+The reader is fail-closed: unsupported versions, hooks, ranks, alpha multipliers, geometries and final-layer
+vectors are refused rather than partially applied. ``TF_DSV41_GLP`` names the file and ``TF_DSV41_GLP_ALPHA``
+optionally overrides its calibrated default. An unset file leaves the captured graphs untouched.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import re
+import struct
+
+import numpy as np
+
+HOOK = "hc_fold_pre_engram"
+
+_SZ = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
+_FM = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f",
+       7: "<B", 10: "<Q", 11: "<q", 12: "<d"}
+_DIRECTION_RE = re.compile(r"direction\.(\d+)(?:\.(\d+))?")
+
+
+def _int_meta(meta: dict, key: str, default: int) -> int:
+    v = meta.get(key)
+    if v is None or v == "":
+        return default
+    return int(float(str(v)))
+
+
+def read_gguf(path: str) -> tuple[dict, dict[str, np.ndarray]]:
+    """Read the GGUF v3 metadata and F32 tensors needed by the control-vector contract."""
+
+    with open(path, "rb") as f:
+        data = f.read()
+    if data[:4] != b"GGUF":
+        raise ValueError(f"{path}: bad magic, not a GGUF file")
+    ver, n_tensors, n_kv = struct.unpack_from("<IQQ", data, 4)
+    if ver != 3:
+        raise ValueError(f"{path}: GGUF version {ver}, expected 3")
+    off = 24
+
+    def rd_string(o):
+        (n,) = struct.unpack_from("<Q", data, o)
+        o += 8
+        return data[o:o + n].decode("utf-8"), o + n
+
+    meta = {}
+    for _ in range(n_kv):
+        key, off = rd_string(off)
+        (vtype,) = struct.unpack_from("<I", data, off)
+        off += 4
+        if vtype == 8:
+            val, off = rd_string(off)
+        elif vtype == 9:
+            etype, cnt = struct.unpack_from("<IQ", data, off)
+            off += 12
+            if etype == 8:
+                val = []
+                for _ in range(cnt):
+                    s, off = rd_string(off)
+                    val.append(s)
+            else:
+                val = struct.unpack_from(f"<{cnt}{_FM[etype][1]}", data, off)
+                off += _SZ[etype] * cnt
+        else:
+            (val,) = struct.unpack_from(_FM[vtype], data, off)
+            off += _SZ[vtype]
+        meta[key] = val
+
+    infos = []
+    for _ in range(n_tensors):
+        name, off = rd_string(off)
+        (nd,) = struct.unpack_from("<I", data, off)
+        off += 4
+        dims = struct.unpack_from(f"<{nd}Q", data, off)
+        off += 8 * nd
+        (tt,) = struct.unpack_from("<I", data, off)
+        off += 4
+        (toff,) = struct.unpack_from("<Q", data, off)
+        off += 8
+        infos.append((name, dims, tt, toff))
+
+    align = meta.get("general.alignment", 32)
+    base = (off + align - 1) // align * align
+    tensors = {}
+    for name, dims, tt, toff in infos:
+        if tt != 0:
+            raise ValueError(f"{path}: {name} is not F32 (ggml type {tt})")
+        n = 1
+        for d in dims:
+            n *= d
+        tensors[name] = np.frombuffer(data, dtype="<f4", count=n, offset=base + toff).copy()
+    return meta, tensors
+
+
+def load(path: str, *, layers: int, width: int) -> tuple[dict[int, np.ndarray], float, int]:
+    """Return ``{zero-based layer: unit direction}``, alpha and a rank-fingerprint hash, or refuse the file."""
+
+    with open(path, "rb") as f:
+        raw = f.read()
+    sha = int.from_bytes(hashlib.sha256(raw).digest()[:4], "little") & 0x7FFF_FFFF
+    meta, tensors = read_gguf(path)
+
+    mode = meta.get("glp.mode")
+    if mode is None:
+        raise ValueError(f"{path}: no glp.mode; refusing to guess additive or projective semantics")
+    if mode != "project":
+        raise ValueError(f"{path}: glp.mode={mode!r}; this engine implements only projective ablation")
+
+    file_hook = meta.get("glp.hook_point")
+    if file_hook != HOOK:
+        raise ValueError(f"{path}: glp.hook_point={file_hook!r}, expected {HOOK!r}")
+    derived_at = meta.get("glp.derived_at", HOOK)
+    if derived_at != HOOK:
+        raise ValueError(f"{path}: glp.derived_at={derived_at!r} does not match the fold's calibration site {HOOK!r}")
+
+    version = _int_meta(meta, "glp.spec_version", 1)
+    if version != 3:
+        raise ValueError(f"{path}: glp.spec_version={version}; the fold and companion writer require version 3")
+    if _int_meta(meta, "glp.rank", 1) != 1:
+        raise ValueError(f"{path}: only rank-1 vectors are implemented; refusing a partially applied subspace")
+    scales = sorted(set(meta) & {"glp.dir_scales", "glp.layer_scales"})
+    if scales:
+        raise ValueError(f"{path}: {', '.join(scales)} requires per-direction/per-layer alphas this engine does not implement")
+
+    alpha = float(meta.get("glp.alpha_default", 1.0))
+    if not math.isfinite(alpha):
+        raise ValueError(f"{path}: glp.alpha_default must be finite")
+
+    grouped: dict[int, dict[int, np.ndarray]] = {}
+    for name, arr in tensors.items():
+        match = _DIRECTION_RE.fullmatch(name)
+        if match is None:
+            if name.startswith("direction."):
+                raise ValueError(f"{path}: malformed direction tensor name {name!r}")
+            continue
+        idx, j = int(match.group(1)), int(match.group(2) or 0)
+        if idx < 1:
+            raise ValueError(f"{path}: {name} is invalid; direction.0 cannot be expressed")
+        if j != 0:
+            raise ValueError(f"{path}: {name} is a rank-{j + 1} direction; only rank 1 is implemented")
+        arr = np.asarray(arr, dtype=np.float32).reshape(-1)
+        if not np.isfinite(arr).all() or not np.any(arr):
+            raise ValueError(f"{path}: {name} must be finite and nonzero")
+        grouped.setdefault(idx, {})[j] = arr
+    if not grouped:
+        raise ValueError(f"{path}: no direction.<N> tensors found")
+
+    declared = meta.get("glp.layer_ids_zero_based")
+    if declared:
+        try:
+            want = sorted(int(x) for x in declared.split(",") if x.strip())
+        except ValueError:
+            raise ValueError(f"{path}: glp.layer_ids_zero_based is not a comma list of integers") from None
+        if want and want != sorted(grouped):
+            raise ValueError(f"{path}: declared layers {want} do not match tensor layers {sorted(grouped)}")
+
+    dirs: dict[int, np.ndarray] = {}
+    for idx, js in grouped.items():
+        if not 0 <= idx < layers - 1:
+            note = (f": layer {idx}'s fold is fused into final normalization in this engine"
+                    if idx == layers - 1 else "")
+            raise ValueError(f"{path}: direction.{idx} has no implemented fold site{note}")
+        vec = js[0].astype(np.float64)
+        if vec.size != width:
+            raise ValueError(f"{path}: direction.{idx} is {vec.size} wide; expected hidden width {width}")
+        norm = np.linalg.norm(vec)
+        if not math.isfinite(norm) or norm <= 0:
+            raise ValueError(f"{path}: direction.{idx} must be finite and nonzero")
+        dirs[idx] = (vec / norm).astype(np.float32)
+    return dirs, alpha, sha
+
+
+def glp_project(x, drow, alpha: float, *, copies: int = 1) -> None:
+    """Project ``h = mean_c(x_c)`` off every copy in place, or a writer when ``copies=1``."""
+
+    import torch
+
+    if x.ndim != 2 or drow.ndim != 1:
+        raise ValueError("glp_project: x must be [rows, copies*hidden] and drow [hidden]")
+    rows, wide = x.shape
+    hidden = drow.numel()
+    if copies < 1 or wide != copies * hidden:
+        raise ValueError(f"glp_project: stream width {wide} != {copies} copies x hidden {hidden}")
+    if x.dtype not in (torch.bfloat16, torch.float32):
+        raise ValueError(f"glp_project: unsupported stream dtype {x.dtype}")
+    if not x.is_cuda:
+        stream = x.reshape(rows, copies, hidden)
+        mean = stream.to(torch.float32).mean(dim=1)
+        delta = (float(alpha) * (mean @ drow)).unsqueeze(-1) * drow
+        stream.sub_(delta.unsqueeze(1).to(x.dtype))
+        return
+    if hidden % 1024:
+        raise ValueError(f"glp_project: hidden width {hidden} is not a multiple of 1024 for the CUDA kernel")
+
+    global _KERNEL
+    if _KERNEL is None:
+        _KERNEL = _kernel()
+    _KERNEL[(rows,)](x, drow, float(alpha), C=copies, D=hidden, BLOCK=1024, num_warps=4)
+
+
+def _kernel():
+    import triton
+    import triton.language as tl
+
+    @triton.jit
+    def _glp_project(X, DIR, alpha, C: tl.constexpr, D: tl.constexpr, BLOCK: tl.constexpr):
+        r = tl.program_id(0)
+        acc = 0.0
+        for cb in tl.static_range(D // BLOCK):
+            d = cb * BLOCK + tl.arange(0, BLOCK)
+            mean = tl.zeros([BLOCK], dtype=tl.float32)
+            for c in tl.static_range(C):
+                x = tl.load(X + r * C * D + c * D + d).to(tl.float32)
+                mean += x / C
+            acc += tl.sum(mean * tl.load(DIR + d), axis=0)
+        coef = alpha * acc
+        for cb in tl.static_range(D // BLOCK):
+            d = cb * BLOCK + tl.arange(0, BLOCK)
+            v = tl.load(DIR + d)
+            for c in tl.static_range(C):
+                off = r * C * D + c * D + d
+                x = tl.load(X + off).to(tl.float32)
+                tl.store(X + off, (x - coef * v).to(X.dtype.element_ty))
+
+    return _glp_project
+
+
+_KERNEL = None
