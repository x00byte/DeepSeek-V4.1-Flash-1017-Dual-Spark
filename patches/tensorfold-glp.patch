+def arm(fw, alpha=0.25):
+    layers, hidden = fw.cfg.num_hidden_layers, fw.cfg.hidden_size
+    table = torch.zeros((layers, hidden))
+    for i in range(1, layers - 1):
+        table[i] = torch.arange(1, hidden + 1).float() * (i + 1)
+        table[i] /= table[i].norm()
+    fw.glp_dirs = table
+    fw.glp_alpha = alpha
+    for blk in fw.blocks:
+        blk.glp_dirs = table
+        blk.glp_alpha = alpha
+    return table
+
+
+def test_zero_table_preserves_stock_forward_exactly(ckpt):
+    fw = build(ckpt, chunk=16)
+    want = run(fw, IDS, [16, 16, 5])
+    arm(fw, alpha=3.5)
+    fw.glp_dirs.zero_()
+    fw.reset()
+    got = run(fw, IDS, [16, 16, 5])
+    assert torch.equal(got, want)
+
