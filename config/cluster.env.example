# Copy to config/cluster.env and edit. These are example fabric addresses.
HEAD_IP=192.0.2.1
WORKER_SSH=spark-b
NCCL_SOCKET_IFNAME=YOUR_FABRIC_INTERFACE
NCCL_IB_HCA=YOUR_ROCE_DEVICE
NCCL_IB_GID_INDEX=3
MASTER_PORT=29571
MODEL_DIR=/srv/models/deepseek-v41-1017/checkpoint
WORKER_MODEL=dsv41-1017-exl3-weights
HEAD_ENGRAM=/srv/deepseek-v41/engram-packed-1017
WORKER_ENGRAM=/srv/deepseek-v41/engram-packed-1017
HEAD_STATE=/srv/deepseek-v41/state
WORKER_STATE=/srv/deepseek-v41/state
IMAGE=deepseek41-tensorfold:1017
CACHE_VOL=deepseek41-1017-tf-cache
NAME=deepseek-v41-flash-1017-tensorfold
HOST=0.0.0.0
PORT=8888
CONTEXT=262144
PARALLEL=8
SERVED_NAME=deepseek-flash
# GLP steering (optional; README's GLP section): a weightless GLP sidecar (GGUF v3, glp.mode=project, hook
# residual_stream_post_layer) at the SAME host path on both nodes. The launcher mounts it read-only at
# /glp/control.gguf and sets TF_DSV41_GLP; `cluster.py check` validates it offline (tools/glpcheck.py) and verifies
# the worker's copy exists, and the engine's rank fingerprint refuses a boot where the two copies differ.
# GLP_ALPHA overrides the file's glp.alpha_default. Empty (the default): no steering, graphs unchanged.
#GLP_FILE=/srv/vectors/dsv41-1017-glp.gguf
#GLP_ALPHA=
