# Effective vLLM tuning. Merge into build/mia-runtime/.env after the host and model paths.
EXL3_FUSED_MOE=1
EXL3_FAT_KERNEL=0
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=32
SPEC_METHOD=dspark
DSPARK_TOKENS=3
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=1536
GPU_MEM_UTIL=0.88
KV_CACHE_MEMORY_BYTES=1073741824
KV_BLOCK_SIZE=64
PREFIX_CACHE_RETENTION_INTERVAL=4096
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=0
DSV41_IO_THREADS=96
DSV41_MEM_GUARD=0
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":8}'
DSV41_BOOT_SHAPE_WARMUP=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_SPINWAIT_MS=stock
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
DSV41_DROP_PAGE_CACHE=1
DSV41_SKIP_MIXED_WARMUP=0
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
DSV41_EXL3_SERIAL_STREAMS=1
DSV41_INDEXER_PREFILL_FACTOR=8
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_PREFILL_EMPTY_CACHE_MEMAVAIL_GIB=2.5
DSV41_PREFILL_END_EMPTY_CACHE=0
EXTRA_ARGS="--cudagraph-capture-sizes 1 2 3 4 6 8 12 16 24 32"
