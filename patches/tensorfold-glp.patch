+def test_steering_changes_forward_and_keeps_tp2_streams_identical(ckpt):
+    baseline = build(ckpt, chunk=16)
+    want = run(baseline, IDS, [16, 16, 5])
+
+    def go(fw):
+        arm(fw)
+        fw.trace = {}
+        return run(fw, IDS, [16, 16, 5]), {k: v.clone() for k, v in fw.trace.items()}
+
+    one = build(ckpt, chunk=16)
+    got, _ = go(one)
+    assert not torch.equal(got, want)
+    _, (a, b) = tp2(ckpt, go, chunk=16)
+    for (out_a, trace_a), (out_b, trace_b) in ((a, b),):
+        assert not torch.equal(out_a, want) and not torch.equal(out_b, want)
+        assert set(trace_a) == set(trace_b)
+        for layer in trace_a:
+            assert torch.equal(trace_a[layer], trace_b[layer]), layer
